# Supabase — use Publishable key (Settings → API Keys → Publishable and secret API keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Agent service (local backend)
NEXT_PUBLIC_AGENT_SERVICE_URL=http://localhost:8000

# Server-side only (never prefix with NEXT_PUBLIC_). Used by the admin API and the shared rate limiter.
SUPABASE_SERVICE_ROLE_KEY=
# Public address of this app, used in invitation / reset links (e.g. https://leads.example.com)
NEXT_PUBLIC_SITE_URL=

# Campaigns (not released yet; needed only when CAMPAIGNS_ENABLED is switched on in lib/config/features.ts)
GEMINI_API_KEY=
EMAIL_MODEL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
